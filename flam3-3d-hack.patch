+/* 3D camera of the Apophysis 3D hack */
+typedef struct {
+   double m[3][3];   /* rotation by pitch and yaw */
+   double persp, zpos, dofcoef;
+} flam3_camera;
+
+static void camera_prepare(flam3_genome *cp, flam3_camera *cam) {
+   double sp = sin(cp->cam_pitch), cpi = cos(cp->cam_pitch);
+   double sy = sin(-cp->cam_yaw), cy = cos(-cp->cam_yaw);
+
+   cam->m[0][0] = cy;
+   cam->m[1][0] = -sy;
+   cam->m[2][0] = 0;
+   cam->m[0][1] = cpi * sy;
+   cam->m[1][1] = cpi * cy;
+   cam->m[2][1] = -sp;
+   cam->m[0][2] = sp * sy;
+   cam->m[1][2] = sp * cy;
+   cam->m[2][2] = cpi;
+   cam->persp = cp->cam_perspective;
+   cam->zpos = cp->cam_zpos;
+   cam->dofcoef = 0.1 * cp->cam_dof;
+}
+
+/* Project the 3D point q (x=q[0], y=q[1], z=q[4]) onto the 2D plane */
+static void camera_project(flam3_camera *cam, double *q, randctx *rc) {
+   double z = q[4] - cam->zpos;
+   double x = cam->m[0][0] * q[0] + cam->m[1][0] * q[1];
+   double y = cam->m[0][1] * q[0] + cam->m[1][1] * q[1] + cam->m[2][1] * z;
+   double zr;
+
+   z = cam->m[0][2] * q[0] + cam->m[1][2] * q[1] + cam->m[2][2] * z;
+   zr = 1 - cam->persp * z;
+
+   if (cam->dofcoef != 0) {
+      /* depth of field: blur proportionally to the distance from the focal plane */
+      double t = flam3_random_isaac_01(rc) * 2 * M_PI;
+      double dr = flam3_random_isaac_01(rc) * cam->dofcoef * z;
+      x += dr * cos(t);
+      y += dr * sin(t);
+   }
+
+   q[0] = x / zr;
+   q[1] = y / zr;
+}
+
+static int flam3_has_camera(flam3_genome *cp) {
+   return cp->cam_pitch != 0 || cp->cam_yaw != 0 || cp->cam_perspective != 0
+       || cp->cam_dof != 0;
+}
