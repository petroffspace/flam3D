-      q[1] = cp->xform[fn].post[0][1] * f.p0 + cp->xform[fn].post[1][1] * f.p1 + cp->xform[fn].post[2][1];
+   if (xf->has_post) {
+      q[0] = xf->post[0][0] * f.p0 + xf->post[1][0] * f.p1 + xf->post[2][0];
+      q[1] = xf->post[0][1] * f.p0 + xf->post[1][1] * f.p1 + xf->post[2][1];
    } else {
       q[0] = f.p0;
       q[1] = f.p1;
    }
